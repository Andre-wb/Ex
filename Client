import socket, threading, json, tkinter as tk

HOST = '192.168.1.42'   # ← IP соседа
PORT = 5000

W, H = 800, 500
PADDLE_W, PADDLE_H = 15, 90
BALL_SIZE = 15

sock = socket.create_connection((HOST, PORT))
print("Подключился к серверу!")

state = {}
my_paddle = H/2 - PADDLE_H/2
lock = threading.Lock()

def receiver():
    global state
    buf = ""
    while True:
        try:
            data = sock.recv(4096).decode()
            if not data: break
            buf += data
            while "\n" in buf:
                line, buf = buf.split("\n", 1)
                with lock:
                    state = json.loads(line)
        except:
            break

threading.Thread(target=receiver, daemon=True).start()

# --- Tkinter (клиент играет справа) ---
root = tk.Tk()
root.title("Pong КЛИЕНТ (ты справа, ↑/↓)")
canvas = tk.Canvas(root, width=W, height=H, bg="#14141e")
canvas.pack()

for y in range(0, H, 30):
    canvas.create_rectangle(W//2 - 2, y, W//2 + 2, y + 15, fill="#3c3c50", outline="")

paddle1 = canvas.create_rectangle(30, H/2, 30 + PADDLE_W, H/2 + PADDLE_H,
                                   fill="#00dcff", outline="")
paddle2 = canvas.create_rectangle(W - 30 - PADDLE_W, my_paddle, W - 30, my_paddle + PADDLE_H,
                                   fill="#ff5a5a", outline="")
ball = canvas.create_oval(0, 0, BALL_SIZE, BALL_SIZE, fill="white", outline="")

score1_text = canvas.create_text(W//2 - 60, 30, text="0", fill="white",
                                  font=("Arial", 32, "bold"))
score2_text = canvas.create_text(W//2 + 60, 30, text="0", fill="white",
                                  font=("Arial", 32, "bold"))
win_text = canvas.create_text(W//2, H//2, text="", fill="#00ff64",
                               font=("Arial", 28, "bold"))

keys = set()
def on_press(e):
    keys.add(e.keysym)
def on_release(e):
    keys.discard(e.keysym)

root.bind("<KeyPress>", on_press)
root.bind("<KeyRelease>", on_release)
root.focus_force()

def move_client():
    global my_paddle
    if 'Up' in keys:
        my_paddle -= 7
    if 'Down' in keys:
        my_paddle += 7
    my_paddle = max(0, min(H - PADDLE_H, my_paddle))
    try:
        sock.sendall((json.dumps({"p2": my_paddle}) + "\n").encode())
    except:
        pass
    root.after(16, move_client)

move_client()

def draw():
    with lock:
        snap = state.copy() if state else {}

    if snap:
        canvas.coords(paddle1, 30, snap["p1"], 30 + PADDLE_W, snap["p1"] + PADDLE_H)
        canvas.coords(ball, snap["ball"]["x"], snap["ball"]["y"],
                      snap["ball"]["x"] + BALL_SIZE, snap["ball"]["y"] + BALL_SIZE)
        canvas.itemconfig(score1_text, text=str(snap["score1"]))
        canvas.itemconfig(score2_text, text=str(snap["score2"]))

        if snap["score1"] >= 5:
            canvas.itemconfig(win_text, text="СОСЕД ВЫИГРАЛ", fill="#ff5050")
        elif snap["score2"] >= 5:
            canvas.itemconfig(win_text, text="ТЫ ВЫИГРАЛ!", fill="#00ff64")
        else:
            canvas.itemconfig(win_text, text="")

    canvas.coords(paddle2, W - 30 - PADDLE_W, my_paddle, W - 30, my_paddle + PADDLE_H)
    root.after(16, draw)

draw()
root.mainloop()
