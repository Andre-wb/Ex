import socket, threading, json, tkinter as tk

HOST, PORT = '0.0.0.0', 5000

W, H = 800, 500
PADDLE_W, PADDLE_H = 15, 90
BALL_SIZE = 15
WIN_SCORE = 5

state = {
    "ball": {"x": W/2, "y": H/2, "vx": 5, "vy": 4},
    "p1": H/2 - PADDLE_H/2,
    "p2": H/2 - PADDLE_H/2,
    "score1": 0,
    "score2": 0,
}
clients = []
lock = threading.Lock()

def reset_ball(direction=1):
    state["ball"] = {"x": W/2, "y": H/2, "vx": 5 * direction, "vy": 4}

def physics():
    b = state["ball"]
    b["x"] += b["vx"]
    b["y"] += b["vy"]

    if b["y"] <= 0 or b["y"] + BALL_SIZE >= H:
        b["vy"] *= -1

    if b["x"] <= 30 + PADDLE_W and b["x"] > 30:
        if state["p1"] < b["y"] + BALL_SIZE and b["y"] < state["p1"] + PADDLE_H:
            b["vx"] = abs(b["vx"])
            offset = (b["y"] + BALL_SIZE/2 - (state["p1"] + PADDLE_H/2)) / (PADDLE_H/2)
            b["vy"] += offset * 2

    if b["x"] + BALL_SIZE >= W - 30 - PADDLE_W and b["x"] < W - 30:
        if state["p2"] < b["y"] + BALL_SIZE and b["y"] < state["p2"] + PADDLE_H:
            b["vx"] = -abs(b["vx"])
            offset = (b["y"] + BALL_SIZE/2 - (state["p2"] + PADDLE_H/2)) / (PADDLE_H/2)
            b["vy"] += offset * 2

    if b["x"] < 0:
        state["score2"] += 1
        reset_ball(1)
    elif b["x"] > W:
        state["score1"] += 1
        reset_ball(-1)

def handle_client(conn, addr):
    print("Подключился:", addr)
    buf = ""
    while True:
        try:
            data = conn.recv(1024).decode()
            if not data: break
            buf += data
            while "\n" in buf:
                line, buf = buf.split("\n", 1)
                msg = json.loads(line)
                with lock:
                    state["p2"] = max(0, min(H - PADDLE_H, msg["p2"]))
        except Exception as e:
            print("Отключился:", addr, e)
            break
    if conn in clients:
        clients.remove(conn)
    conn.close()

def network_loop():
    import time
    while True:
        with lock:
            physics()
            snapshot = json.dumps(state)
        for c in list(clients):
            try:
                c.sendall((snapshot + "\n").encode())
            except:
                if c in clients: clients.remove(c)
        time.sleep(1/60)

# --- Сеть ---
s = socket.socket()
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind((HOST, PORT))
s.listen()
print(f"Сервер запущен на порту {PORT}, жду игрока...")

threading.Thread(target=network_loop, daemon=True).start()

def accept_loop():
    while True:
        conn, addr = s.accept()
        clients.append(conn)
        threading.Thread(target=handle_client, args=(conn, addr), daemon=True).start()

threading.Thread(target=accept_loop, daemon=True).start()

# --- Tkinter (сервер играет слева) ---
root = tk.Tk()
root.title("Pong ХОСТ (ты слева, W/S)")
canvas = tk.Canvas(root, width=W, height=H, bg="#14141e")
canvas.pack()

# сетка
for y in range(0, H, 30):
    canvas.create_rectangle(W//2 - 2, y, W//2 + 2, y + 15, fill="#3c3c50", outline="")

paddle1 = canvas.create_rectangle(30, state["p1"], 30 + PADDLE_W, state["p1"] + PADDLE_H,
                                   fill="#00dcff", outline="")
paddle2 = canvas.create_rectangle(W - 30 - PADDLE_W, state["p2"], W - 30, state["p2"] + PADDLE_H,
                                   fill="#ff5a5a", outline="")
ball = canvas.create_oval(0, 0, BALL_SIZE, BALL_SIZE, fill="white", outline="")

score1_text = canvas.create_text(W//2 - 60, 30, text="0", fill="white",
                                  font=("Arial", 32, "bold"))
score2_text = canvas.create_text(W//2 + 60, 30, text="0", fill="white",
                                  font=("Arial", 32, "bold"))
win_text = canvas.create_text(W//2, H//2, text="", fill="#00ff64",
                               font=("Arial", 28, "bold"))

# Управление хостом
keys = set()
def on_press(e):
    keys.add(e.keysym.lower())
def on_release(e):
    keys.discard(e.keysym.lower())

root.bind("<KeyPress>", on_press)
root.bind("<KeyRelease>", on_release)
root.focus_force()

def move_host():
    with lock:
        if 'w' in keys:
            state["p1"] -= 7
        if 's' in keys:
            state["p1"] += 7
        state["p1"] = max(0, min(H - PADDLE_H, state["p1"]))
    root.after(16, move_host)

move_host()

def draw():
    with lock:
        snap = state.copy()
        b = snap["ball"].copy()

    canvas.coords(paddle1, 30, snap["p1"], 30 + PADDLE_W, snap["p1"] + PADDLE_H)
    canvas.coords(paddle2, W - 30 - PADDLE_W, snap["p2"], W - 30, snap["p2"] + PADDLE_H)
    canvas.coords(ball, b["x"], b["y"], b["x"] + BALL_SIZE, b["y"] + BALL_SIZE)

    canvas.itemconfig(score1_text, text=str(snap["score1"]))
    canvas.itemconfig(score2_text, text=str(snap["score2"]))

    if snap["score1"] >= WIN_SCORE:
        canvas.itemconfig(win_text, text="ТЫ ВЫИГРАЛ!", fill="#00ff64")
    elif snap["score2"] >= WIN_SCORE:
        canvas.itemconfig(win_text, text="СОСЕД ВЫИГРАЛ", fill="#ff5050")
    else:
        canvas.itemconfig(win_text, text="")

    root.after(16, draw)

draw()
root.mainloop() 
