import tkinter as tk

W, H = 800, 500
PADDLE_W, PADDLE_H = 15, 90
BALL_SIZE = 15
WIN_SCORE = 5
PADDLE_SPEED = 7

# --- Настройки ускорения ---
START_SPEED = 5          # начальная скорость мяча по X
SPEED_UP = 1.08          # во сколько раз ускоряется за удар (1.08 = +8%)
MAX_SPEED = 20           # предел скорости (чтобы не пролетало сквозь ракетку)
MAX_VY = 14              # предел вертикальной скорости

state = {
    "ball": {"x": W/2, "y": H/2, "vx": START_SPEED, "vy": 4},
    "p1": H/2 - PADDLE_H/2,
    "p2": H/2 - PADDLE_H/2,
    "score1": 0,
    "score2": 0,
    "game_over": False,
    "pause": 0,
    "rally": 0,          # счётчик ударов в текущем раунде (для отображения)
}

def reset_ball(direction=1):
    state["ball"] = {"x": W/2, "y": H/2, "vx": START_SPEED * direction, "vy": 4}
    state["pause"] = 45
    state["rally"] = 0

def limit_speed(b):
    """Ограничивает скорость мяча по X и Y."""
    if b["vx"] > MAX_SPEED:
        b["vx"] = MAX_SPEED
    elif b["vx"] < -MAX_SPEED:
        b["vx"] = -MAX_SPEED
    b["vy"] = max(-MAX_VY, min(MAX_VY, b["vy"]))

def accelerate(b):
    """Ускоряет мяч после удара по ракетке."""
    b["vx"] *= SPEED_UP
    b["vy"] *= SPEED_UP
    limit_speed(b)

def physics():
    if state["game_over"]:
        return
    if state["pause"] > 0:
        state["pause"] -= 1
        return

    b = state["ball"]
    b["x"] += b["vx"]
    b["y"] += b["vy"]

    # отскок от верх/низ
    if b["y"] <= 0:
        b["y"] = 0
        b["vy"] = abs(b["vy"])
    elif b["y"] + BALL_SIZE >= H:
        b["y"] = H - BALL_SIZE
        b["vy"] = -abs(b["vy"])

    # левая ракетка
    if b["x"] <= 30 + PADDLE_W and b["x"] > 30:
        if state["p1"] < b["y"] + BALL_SIZE and b["y"] < state["p1"] + PADDLE_H:
            b["x"] = 30 + PADDLE_W
            b["vx"] = abs(b["vx"])
            offset = (b["y"] + BALL_SIZE/2 - (state["p1"] + PADDLE_H/2)) / (PADDLE_H/2)
            b["vy"] += offset * 2
            accelerate(b)              # ← ускорение
            state["rally"] += 1

    # правая ракетка
    if b["x"] + BALL_SIZE >= W - 30 - PADDLE_W and b["x"] < W - 30:
        if state["p2"] < b["y"] + BALL_SIZE and b["y"] < state["p2"] + PADDLE_H:
            b["x"] = W - 30 - PADDLE_W - BALL_SIZE
            b["vx"] = -abs(b["vx"])
            offset = (b["y"] + BALL_SIZE/2 - (state["p2"] + PADDLE_H/2)) / (PADDLE_H/2)
            b["vy"] += offset * 2
            accelerate(b)              # ← ускорение
            state["rally"] += 1

    # голы
    if b["x"] < 0:
        state["score2"] += 1
        check_win()
        if not state["game_over"]:
            reset_ball(1)
    elif b["x"] > W:
        state["score1"] += 1
        check_win()
        if not state["game_over"]:
            reset_ball(-1)

def check_win():
    if state["score1"] >= WIN_SCORE or state["score2"] >= WIN_SCORE:
        state["game_over"] = True

def move_paddles(keys):
    if state["game_over"]:
        return
    if 'w' in keys:
        state["p1"] -= PADDLE_SPEED
    if 's' in keys:
        state["p1"] += PADDLE_SPEED
    state["p1"] = max(0, min(H - PADDLE_H, state["p1"]))

    if 'Up' in keys:
        state["p2"] -= PADDLE_SPEED
    if 'Down' in keys:
        state["p2"] += PADDLE_SPEED
    state["p2"] = max(0, min(H - PADDLE_H, state["p2"]))

# --- Tkinter ---
root = tk.Tk()
root.title("Pong — Игрок 1: W/S   |   Игрок 2: ↑/↓   |   R — рестарт")
canvas = tk.Canvas(root, width=W, height=H, bg="#14141e")
canvas.pack()

for y in range(0, H, 30):
    canvas.create_rectangle(W//2 - 2, y, W//2 + 2, y + 15, fill="#3c3c50", outline="")

paddle1 = canvas.create_rectangle(30, state["p1"], 30 + PADDLE_W,
                                   state["p1"] + PADDLE_H, fill="#00dcff", outline="")
paddle2 = canvas.create_rectangle(W - 30 - PADDLE_W, state["p2"], W - 30,
                                   state["p2"] + PADDLE_H, fill="#ff5a5a", outline="")

# след мяча (несколько кружков разного размера/цвета — эффект шлейфа)
trail = [canvas.create_oval(0, 0, 0, 0, fill="", outline="") for _ in range(6)]
ball = canvas.create_oval(0, 0, BALL_SIZE, BALL_SIZE, fill="white", outline="")

score1_text = canvas.create_text(W//2 - 60, 30, text="0", fill="white",
                                  font=("Arial", 32, "bold"))
score2_text = canvas.create_text(W//2 + 60, 30, text="0", fill="white",
                                  font=("Arial", 32, "bold"))

canvas.create_text(80, H - 20, text="W / S", fill="#00dcff", font=("Arial", 14))
canvas.create_text(W - 80, H - 20, text="↑ / ↓", fill="#ff5a5a", font=("Arial", 14))

# индикатор скорости
speed_text = canvas.create_text(W//2, H - 20, text="Скорость: 1.0x",
                                 fill="#aaaaaa", font=("Arial", 12))

win_text = canvas.create_text(W//2, H//2 - 20, text="", fill="#00ff64",
                               font=("Arial", 32, "bold"))
hint_text = canvas.create_text(W//2, H//2 + 30, text="", fill="#aaaaaa",
                                font=("Arial", 16))

# история позиций мяча для шлейфа
ball_history = []

keys = set()

def on_press(e):
    if e.keysym in ('r', 'R'):
        state["score1"] = 0
        state["score2"] = 0
        state["game_over"] = False
        state["p1"] = H/2 - PADDLE_H/2
        state["p2"] = H/2 - PADDLE_H/2
        ball_history.clear()
        reset_ball(1)
        return
    keys.add(e.keysym)

def on_release(e):
    keys.discard(e.keysym)

root.bind("<KeyPress>", on_press)
root.bind("<KeyRelease>", on_release)
root.focus_force()

def tick():
    move_paddles(keys)
    physics()
    draw()
    root.after(16, tick)

def draw():
    b = state["ball"]

    # обновляем историю позиций для шлейфа
    if state["pause"] == 0 and not state["game_over"]:
        ball_history.append((b["x"], b["y"]))
        if len(ball_history) > len(trail):
            ball_history.pop(0)

    # рисуем шлейф
    for i, t in enumerate(trail):
        if i < len(ball_history):
            hx, hy = ball_history[i]
            # чем старше — тем тусклее и меньше
            alpha = i / len(trail)  # 0..1
            size = BALL_SIZE * (0.4 + 0.6 * alpha)
            # цвет от тёмно-синего к яркому
            shade = int(60 + 120 * alpha)
            color = f"#{shade:02x}{shade:02x}{min(255, shade+80):02x}"
            canvas.coords(t, hx, hy, hx + size, hy + size)
            canvas.itemconfig(t, fill=color)
        else:
            canvas.coords(t, -10, -10, -10, -10)  # спрятать

    canvas.coords(paddle1, 30, state["p1"], 30 + PADDLE_W, state["p1"] + PADDLE_H)
    canvas.coords(paddle2, W - 30 - PADDLE_W, state["p2"], W - 30, state["p2"] + PADDLE_H)
    canvas.coords(ball, b["x"], b["y"], b["x"] + BALL_SIZE, b["y"] + BALL_SIZE)

    canvas.itemconfig(score1_text, text=str(state["score1"]))
    canvas.itemconfig(score2_text, text=str(state["score2"]))

    # индикатор скорости (относительно стартовой)
    speed_factor = abs(b["vx"]) / START_SPEED
    canvas.itemconfig(speed_text, text=f"Скорость: {speed_factor:.1f}x")

    if state["game_over"]:
        if state["score1"] > state["score2"]:
            canvas.itemconfig(win_text, text="ИГРОК 1 ПОБЕДИЛ!", fill="#00dcff")
        else:
            canvas.itemconfig(win_text, text="ИГРОК 2 ПОБЕДИЛ!", fill="#ff5a5a")
        canvas.itemconfig(hint_text, text="Нажми R для новой игры")
    else:
        canvas.itemconfig(win_text, text="")
        canvas.itemconfig(hint_text, text="")

tick()
root.mainloop()
